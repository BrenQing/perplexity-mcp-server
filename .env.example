# Copy to .env and fill in. Required.
# Get a key at https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# Optional: transport to use — "stdio" (default) or "http".
# TRANSPORT=stdio

# Optional (HTTP transport only): port (default 3000) and bind host.
# HOST defaults to 127.0.0.1 (loopback) so the server is NOT exposed on the
# network unless you deliberately change it.
# PORT=3000
# HOST=127.0.0.1

# Optional (HTTP transport only): shared secret. When set, every POST /mcp must
# send "Authorization: Bearer <token>". The /mcp endpoint spends your Perplexity
# key, so set this (and/or front it with an authenticated proxy) before binding
# to any non-loopback HOST.
# MCP_AUTH_TOKEN=
